:root{--gold:#f2c230;--gold2:#d99a0b;--ink:#15120d;--ink2:#221d14;--cream:#fff8e6;--red:#c0392b;--wa:#1fa855;--r:16px}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font-family:Georgia,"Times New Roman",serif;background:var(--cream);color:var(--ink);line-height:1.5;overflow-x:hidden}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--red);outline-offset:2px}
.nav{position:fixed;inset:0 0 auto 0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:.7rem 1.2rem;background:var(--ink);color:var(--gold);height:64px}
.brand{font-size:1.25rem;font-weight:700}.brand small{font-weight:400;font-size:.8rem;color:#fff;margin-left:.3rem}
.links{display:flex;gap:1.4rem;align-items:center;font-family:system-ui,sans-serif;font-weight:600}
.links a:hover{color:#fff}
.pill{background:var(--wa);color:#fff;padding:.45rem 1rem;border-radius:99px}
.links .pill:hover{background:#178a45}
.burger{display:none;background:none;border:0;width:44px;height:44px;cursor:pointer;flex-direction:column;justify-content:center;gap:6px;align-items:center}
.burger span{display:block;width:26px;height:3px;background:var(--gold);border-radius:2px;transition:.25s}
.burger.open span:nth-child(1){transform:translateY(9px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-9px) rotate(-45deg)}
.hero{position:relative;min-height:100svh;padding:110px 1.2rem 60px;background:var(--gold);display:flex;align-items:center;overflow:hidden}
.hero::after{content:"";position:absolute;right:-20%;bottom:-30%;width:90vmin;height:90vmin;border-radius:50%;background:var(--ink);opacity:.92}
.hero-in{position:relative;z-index:2;max-width:640px;margin:0 auto 0 max(0px,calc((100% - 1100px)/2))}
.kicker{font-family:system-ui,sans-serif;font-weight:600;margin-bottom:.6rem}
h1{font-size:clamp(2.8rem,10vw,5.6rem);line-height:1;color:var(--red)}
h1 span{font-size:.5em;letter-spacing:.12em;color:var(--ink)}
.lead{margin:1.2rem 0 1.6rem;font-size:1.15rem;max-width:30ch}
.sun{position:absolute;right:6%;top:50%;transform:translateY(-50%);font-size:clamp(5rem,20vw,13rem);z-index:2;animation:float 4s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-56%)}}
.btns{display:flex;flex-wrap:wrap;gap:.7rem}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.7rem 1.4rem;border-radius:99px;font-family:system-ui,sans-serif;font-weight:700;transition:transform .2s,box-shadow .2s;box-shadow:0 4px 14px #0003}
.btn:hover{transform:translateY(-2px)}
.primary{background:var(--red);color:#fff}.dark{background:var(--ink);color:var(--gold)}.wa{background:var(--wa);color:#fff}
.sec{max-width:1100px;margin:0 auto;padding:4.5rem 1.2rem}
h2{font-size:clamp(2rem,6vw,3rem);margin-bottom:.5rem}
.note{font-family:system-ui,sans-serif;font-size:.9rem;color:#6b5a2e;margin-bottom:1.2rem}
.tabs{position:sticky;top:64px;z-index:20;display:flex;gap:.5rem;overflow-x:auto;padding:.6rem 0;background:var(--cream);scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs a{flex:none;padding:.5rem 1rem;border-radius:99px;background:var(--ink);color:var(--gold);font-family:system-ui,sans-serif;font-weight:600;font-size:.9rem}
.tabs a.on,.tabs a:hover{background:var(--gold);color:var(--ink)}
.cat{margin-top:2rem;scroll-margin-top:130px}
.cat h3{font-size:1.6rem;border-bottom:3px solid var(--gold);padding-bottom:.3rem;margin-bottom:.3rem}
.cat .sub{font-family:system-ui,sans-serif;font-size:.9rem;color:#6b5a2e;margin-bottom:.8rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem;margin-top:.8rem}
.card{background:var(--ink);color:#fff;border-radius:var(--r);padding:1.1rem;box-shadow:0 6px 18px #0002;transition:transform .2s}
.card:hover{transform:translateY(-3px)}
.card h4{color:var(--gold);font-size:1.15rem;margin-bottom:.6rem}
.opt{display:flex;justify-content:space-between;gap:.8rem;padding:.35rem 0;border-top:1px dashed #ffffff33;font-family:system-ui,sans-serif;font-size:.95rem}
.opt b{color:var(--gold);white-space:nowrap}
.opt b.tbc{color:#ff9d8f;white-space:normal;text-align:right;font-weight:600;font-size:.82rem}
.combo{margin-top:2rem;padding:1rem;background:var(--gold);border-radius:var(--r);text-align:center;font-weight:700;font-size:1.15rem}
.contact{padding-top:2rem}
.cards2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-top:1rem}
.box{background:var(--ink);color:#fff;border-radius:var(--r);padding:1.5rem}
.box h3{color:var(--gold);margin-bottom:.6rem}
.tel{font-size:2rem;font-weight:700;margin-bottom:1rem}
.hours{list-style:none;padding:0;font-family:system-ui,sans-serif}
.hours li{display:flex;flex-direction:column;padding:.7rem 0;border-top:1px dashed #ffffff33}
.hours b{color:var(--gold);font-size:1.15rem}
footer{background:var(--ink);color:#fff;text-align:center;padding:1.5rem 1rem 5.5rem;font-family:system-ui,sans-serif;font-size:.9rem;display:flex;flex-direction:column;gap:.4rem}
footer a{color:var(--gold)}
.fab{position:fixed;right:14px;bottom:14px;z-index:40;background:var(--wa);color:#fff;padding:.8rem 1.2rem;border-radius:99px;font-family:system-ui,sans-serif;font-weight:700;box-shadow:0 6px 18px #0005}
@media(max-width:780px){
  .burger{display:flex}
  .links{position:fixed;top:64px;left:0;right:0;flex-direction:column;gap:0;background:var(--ink);padding:.5rem 1.2rem 1.2rem;transform:translateY(-130%);transition:transform .3s;z-index:-1}
  .links.open{transform:none}
  .links a{width:100%;padding:.9rem 0;border-bottom:1px solid #ffffff22}
  .links .pill{margin-top:.8rem;text-align:center;border:0}
  .hero::after{right:-40%;bottom:-20%}
  .sun{top:auto;bottom:6%;right:6%;transform:none;animation:none}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
